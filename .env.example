# Example environment variables for RAG project
# Replace the placeholder values with your own keys before running.
# Do NOT commit real keys to GitHub — keep them in `.env` (which should be ignored).

# GROQ (image/LLM provider) API key
GROQ_API_KEY=

# LlamaIndex / Llama Cloud API key (optional)
LLAMA_CLOUD_API_KEY=

# Backend / Frontend configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
